# Copy to .secret.env and supply values for your environment. Never commit .secret.env.
# PostgreSQL and backend must use the same DB_PASSWORD.
DB_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD

# SMTP credentials; APP_MAIL_PROVIDER may be smtp or sendgrid.
MAIL_ADDRESS=REPLACE_WITH_SENDER_EMAIL
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
APP_MAIL_PROVIDER=smtp
SEND_GRID=
MAIL_FROM=REPLACE_WITH_SENDER_EMAIL
MAIL_NAME=Mosquizto

# Generate three independent Base64 keys, e.g. openssl rand -base64 48.
JWT_ACCESS_KEY=REPLACE_WITH_BASE64_ACCESS_KEY
JWT_REFRESH_KEY=REPLACE_WITH_BASE64_REFRESH_KEY
JWT_RESET_KEY=REPLACE_WITH_BASE64_RESET_KEY

GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
MEILI_MASTER_KEY=REPLACE_WITH_MEILI_MASTER_KEY
CLOUDINARY_NAME=REPLACE_WITH_CLOUDINARY_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_CLOUDINARY_API_SECRET

# Preserved in the env-file source; these settings are not passwords.
WS_MESSAGE_TIME_OUT=500
WS_CONNECT_ENDPOINT=/ws-connection
SERVER_NAME=mosquizto
